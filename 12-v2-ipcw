#rename to keep data_unweighted intact in case changes are needed
data_ps_hosp <- data_unweighted

#now calculate the weights
#note we do one without stabilization on marginal probability, but the rest we all stabilize on marginal probability to reduce extreme weights
#and because it does no harm, no difficulty in interpretation
data_ps_hosp %<>%
  group_by(id, .imp) %>%
  mutate(
    #first just the normal weights (combined_true_weights), we start with informative censoring
    ipcw_inf_cens_true = case_when(
      inf_cens_incl_death == 1 ~ 1/ (1- ps),
      inf_cens_incl_death == 0 ~ 1/ps),
    #then arificial censoring
    ipcw_art_cens = case_when(
      art_cens == 1 ~ 1/ (1- ps_art),
      art_cens == 0 ~ 1/ps_art),
    #artificial may be NA because this is only calculated over the first 7 visits, the rest should be 1 (so no effect)
    ipcw_art_cens = if_else(is.na(ipcw_art_cens), 1, ipcw_art_cens), #set missingness to 1,
    #now combine artificial and informative
    combined_true_weights = ipcw_art_cens * ipcw_inf_cens_true,
    #now cumulative product
    combined_true_weights_cumprod = cumprod(combined_true_weights), 
    #stabilized, first informative
    stab_ipcw_inf_cens = case_when(
      inf_cens_incl_death == 1 ~ prop_score_marg/ (1- ps),
      inf_cens_incl_death == 0 ~ prop_score_marg/ps),
    stab_ipcw_art_cens = case_when(
      art_cens == 1 ~ prop_score_marg_art/ (1- ps_art),
      art_cens == 0 ~ prop_score_marg_art/ps_art),
    #also here there may be NA's which should be 1
    stab_ipcw_art_cens = if_else(is.na(stab_ipcw_art_cens), 1, stab_ipcw_art_cens), #set missingness to 1, 
    stab_combined = stab_ipcw_inf_cens * stab_ipcw_art_cens,
    stab_combined_cumprod = cumprod(stab_combined),
    #fixed effects, first informative
    fixed_ipcw_cens =  case_when(
      inf_cens_incl_death == 1 ~ prop_score_fixed/ (1- ps),
      inf_cens_incl_death == 0 ~ prop_score_fixed/ps),
    #then artificial fixed
    ipcw_art_fixed =  case_when(
      art_cens == 1 ~ prop_score_fixed_art/ (1- ps_art),
      art_cens == 0 ~ prop_score_fixed_art/ps_art),
    ipcw_art_fixed = if_else(is.na(ipcw_art_fixed), 1, ipcw_art_fixed),
    #now combined
    fixed_combined = ipcw_art_fixed * fixed_ipcw_cens,
    fixed_combined_cumprod = cumprod(fixed_combined),
    #now pooled over all visits
    ipcw_inf_cens_pool_true = case_when(
      inf_cens_incl_death == 1 ~ prop_score_marg/ (1- ps_pool),
      inf_cens_incl_death == 0 ~ prop_score_marg/ps_pool),
    #now for artificial
    ipcw_art_cens_pool = case_when(
      art_cens == 1 ~ prop_score_marg_art/ (1- ps_pool_art),
      art_cens == 0 ~ prop_score_marg_art/ps_pool_art),
    ipcw_art_cens_pool = if_else(is.na(ipcw_art_cens_pool), 1, ipcw_art_cens_pool),
    #now combine
    combine_pool_visits = ipcw_inf_cens_pool_true * ipcw_art_cens_pool,
    combine_pool_visits_cumprod = cumprod(combine_pool_visits),
    #now combine artificial and informative censoring
    ipcw_inf_art = case_when(
