   dat_imputed_both_clones %<>%
     mutate(
    modality = if_else(mod_mis == 1, 0, modality), #if modality is missing we assume HD
    txt_substitution_volume = if_else(modality == 0, 0, txt_substitution_volume), #with HD, substitution volume should be 0
