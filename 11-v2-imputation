#create stacked dataset of both 
#and make variable to note which one has longest follow-up
stacked <- bind_rows(cohort_hd_reduced, cohort_hdf_reduced) %>%
  arrange(id) %>%
  group_by(id)%>%
  mutate(
    max_fu = max(cens_time), #determine max cens time irrespective of treatment clone
    cens_time_hdf = if_else(treatment_clone == "hdf", cens_time, 0), #determine censor time specific for hdf strategy
    cens_time_hd = if_else(treatment_clone == "hd", cens_time, 0),
    #aggregate cens time hdf and hd
    cens_time_hdf = max(cens_time_hdf),
    cens_time_hd = max(cens_time_hd),
    cens_reason_hd = if_else(treatment_clone == "hd", cens_reason, NA),
    cens_reason_hdf = if_else(treatment_clone == "hdf", cens_reason, NA),
    max_clone = if_else(max_fu == cens_time_hdf, "hdf", "hd"),
    #first define what current clone is
    long_clone = if_else(treatment_clone == max_clone, 1, 0) #note which clone corresponds to longest follow-up
  )%>%
  fill(cens_reason_hd, cens_reason_hdf, .direction = "downup")%>%
  ungroup()

#we want to keep the rows only of the clone with longest follow-up for imputation
#in addition, we want to keep columns with specific data for both clones, in this case: cens_time & reason for both hdf and HD
impute_longest <- stacked %>%
  filter(long_clone == 1)

